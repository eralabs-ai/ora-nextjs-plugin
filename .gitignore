# Generated by ora-catalog's postbuild step in fixtures — build output, not a fixture source file.
# Scoped to the generated file itself (not the whole .well-known/ dir) so a fixture can still check
# in a hand-authored file there (e.g. to test overwrite/collision behavior) without being ignored.
fixtures/**/public/.well-known/ai-catalog.json

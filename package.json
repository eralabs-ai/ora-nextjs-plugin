{
  "name": "ora-nextjs-plugin-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter \"./packages/*\" run test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "fixtures:clean": "node scripts/clean-fixture-outputs.mjs",
    "fixtures:build": "pnpm --filter \"@ax-fixtures/*\" run build",
    "reports:verify": "node scripts/verify-report-snapshots.mjs",
    "dogfood:middleware": "node scripts/dogfood-middleware.mjs",
    "reports:regen": "pnpm fixtures:clean && pnpm fixtures:build && node scripts/verify-report-snapshots.mjs --update",
    "conformance": "bash scripts/conformance.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}

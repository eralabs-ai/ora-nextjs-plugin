{
  "name": "@ora-ai/ax-nextjs",
  "version": "0.0.0",
  "description": "Agent Experience (AX) toolkit for Next.js: generate a spec-valid ai-catalog.json, detect WebMCP tools, scaffold agent-aware 404s, and report agent-readiness at build time.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eralabs-ai/ora-nextjs-plugin.git",
    "directory": "packages/ax"
  },
  "homepage": "https://github.com/eralabs-ai/ora-nextjs-plugin#readme",
  "bugs": "https://github.com/eralabs-ai/ora-nextjs-plugin/issues",
  "keywords": [
    "nextjs",
    "ai-agents",
    "agent-experience",
    "ai-catalog",
    "mcp",
    "llms-txt",
    "agent-readiness",
    "ard"
  ],
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    }
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ax": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node -e \"require('fs').chmodSync('dist/bin.js', 0o755)\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jiti": "^2.7.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "peerDependencies": {
    "next": ">=15"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.17.12",
    "@types/turndown": "^5.0.6",
    "next": "^15.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
